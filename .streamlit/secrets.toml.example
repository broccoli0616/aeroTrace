# Template for Streamlit Community Cloud: paste into App settings -> Secrets (fill in the values).
# Locally you can copy it to .streamlit/secrets.toml (gitignored) or keep using .env.

# Password for the demo. Share it only with the people who should use the app.
APP_PASSWORD = ""

# Optional: "Let Claude write the answer"
ANTHROPIC_API_KEY = ""

# Optional: semantic search. An OpenRouter key (sk-or-...) or OpenAI key (sk-...).
# Leave AEROTRACE_EMBEDDINGS empty to use keyword search only (faster start, no embedding cost).
OPENAI_API_KEY = ""
AEROTRACE_EMBEDDINGS = "openai"
