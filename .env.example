# Enables "Answer with Claude" and the legacy "Let Claude write the answer" toggle.
ANTHROPIC_API_KEY=
# Optional Claude answer model (default: claude-sonnet-5-5).
# AEROTRACE_MODEL=claude-sonnet-5-5
# AEROTRACE_EMBEDDINGS=1

# OpenRouter two-stage semantic retrieval and embedding smoke test
OPENROUTER_API_KEY=
AEROTRACE_EMBEDDING_MODEL=openai/text-embedding-3-large
# Optional: keep the same dimensions for all summaries, chunks, and queries.
# AEROTRACE_EMBEDDING_DIMENSIONS=3072
# An OpenRouter-format key in OPENAI_API_KEY is also supported for existing setups.
